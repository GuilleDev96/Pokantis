<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_fondo"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivLogoMenu"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:adjustViewBounds="true"
        android:src="@drawable/splash_letras" />

    <Button
        android:id="@+id/btnJugar"
        android:layout_width="280dp"
        android:layout_height="75dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_boton_principal"
        android:backgroundTint="@null"
        android:elevation="8dp"
        android:text="JUGAR PARTIDA"
        android:textColor="#0F2A1D"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPerfil"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_boton_secundario"
        android:backgroundTint="@null"
        android:elevation="4dp"
        android:text="ESTADISTICAS"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnOpciones"
        android:layout_width="280dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_boton_secundario"
        android:backgroundTint="@null"
        android:elevation="4dp"
        android:text="OPCIONES"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>