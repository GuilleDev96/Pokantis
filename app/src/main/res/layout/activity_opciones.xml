<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_fondo">

    <ImageButton
        android:id="@+id/btnVolverOpciones"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:elevation="10dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVolverOpciones">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Música de Fondo"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgMusica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbMusica1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pokémon Amarillo"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbMusica2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pokémon Oro/Plata"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbMusica3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pokémon Rojo Fuego"
                        android:textStyle="bold" />

                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Fondo del Tapete"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgTapete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbTapete1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tapete 1"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbTapete2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tapete 2"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbTapete3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tapete 3"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbTapete4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tapete 4"
                        android:textStyle="bold" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>